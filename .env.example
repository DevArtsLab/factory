# Factory CLI environment (all optional).

# Brain backend: off | file (default: file — .factory/brain/<repo>.md)
# FACTORY_BRAIN=file

# Devin CLI override (default: `devin` on PATH)
# DEVIN_BIN=/path/to/devin

# Devin API key override (default: windsurf_api_key from
# ~/.local/share/devin/credentials.toml)
# DEVIN_API_KEY=
