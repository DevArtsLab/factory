# Factory CLI environment (all optional).

# Brain backend: off | file (default: file — .factory/brain/<repo>.md)
# FACTORY_BRAIN=file

# Devin CLI override (default: `devin` on PATH)
# DEVIN_BIN=/path/to/devin

# Devin API key override (default: windsurf_api_key from
# ~/.local/share/devin/credentials.toml)
# DEVIN_API_KEY=

# Webhook intake daemon (`pnpm factory intake`) — shared secret, required
# to start the daemon
# FACTORY_WEBHOOK_SECRET=

# Intake listen port (default: 3210)
# FACTORY_INTAKE_PORT=3210

# Intake: log spawn intent without spawning runs (default: off)
# FACTORY_INTAKE_DRY_RUN=1

# Intake: comment on the issue when a run exits (default: off)
# FACTORY_INTAKE_COMMENT=1
